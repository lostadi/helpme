#!/usr/bin/env O
# helpme map — make the invisible environment visible.
# Shows shell, PATH layout, Termux/prefix, man paths, and index coverage.
#
# Env: HELPME_DB

python^(
import os, sqlite3, sys, shutil, platform
from pathlib import Path

DB  = os.environ.get("HELPME_DB", os.path.expanduser("~/.local/share/helpme/db/index.db"))
SEP = "─" * 72
lines = []

def section(title):
    lines.append("")
    lines.append(f"\033[1;33m{title}\033[0m")
    lines.append(SEP)

def row(label, value):
    lines.append(f"  \033[1m{label:<18}\033[0m {value}")

lines.append(f"\033[1;32mhelpme map\033[0m  \033[90m— the parts of your CLI that are usually invisible\033[0m")

# --- Host --- #
section("Host")
row("OS", f"{platform.system()} {platform.release()}")
row("Machine", platform.machine())
row("Python", platform.python_version())
row("User", os.environ.get("USER") or os.environ.get("LOGNAME") or "?")
row("Home", os.path.expanduser("~"))

# --- Shell --- #
section("Shell")
shell = os.environ.get("SHELL", "")
row("SHELL", shell or "(unset)")
row("0 / argv0", os.environ.get("0", ""))
for var in ("ZSH_VERSION", "BASH_VERSION", "FISH_VERSION"):
    if os.environ.get(var):
        row(var, os.environ[var])

# --- Termux / prefix --- #
section("Prefix / Termux")
prefix = os.environ.get("PREFIX", "")
termux = bool(prefix and os.path.isdir(prefix) and "com.termux" in prefix)
row("Termux", "yes" if termux else "no")
row("PREFIX", prefix or "(unset — desktop/linux style)")
if termux:
    row("Termux root", str(Path(prefix).parent) if prefix else "")
    for tool in ("pkg", "termux-info", "termux-setup-storage", "termux-api"):
        path = shutil.which(tool)
        row(tool, path or "\033[90mnot on PATH\033[0m")
    # Storage visibility — common Termux hidden knowledge
    home = Path.home()
    storage = home / "storage"
    if storage.is_dir():
        links = [p.name for p in storage.iterdir()]
        row("~/storage", "set up → " + ", ".join(links[:8]) + ("…" if len(links) > 8 else ""))
    else:
        row("~/storage", "\033[33mmissing — run: termux-setup-storage\033[0m")

# --- PATH (the real inventory map) --- #
section("PATH directories (search order)")
path_dirs = [d for d in os.environ.get("PATH", "").split(":") if d]
if not path_dirs:
    lines.append("  \033[31mPATH is empty\033[0m")
else:
    for i, d in enumerate(path_dirs, 1):
        exists = os.path.isdir(d)
        count = 0
        if exists:
            try:
                count = sum(
                    1 for n in os.listdir(d)
                    if os.path.isfile(os.path.join(d, n)) and os.access(os.path.join(d, n), os.X_OK)
                )
            except OSError:
                count = -1
        mark = "\033[32m✓\033[0m" if exists else "\033[31m✗\033[0m"
        cnt = f"{count} bins" if count >= 0 else "?"
        lines.append(f"  {i:>2}. {mark} \033[1m{d}\033[0m  \033[90m({cnt})\033[0m")

# --- Doc systems --- #
section("Documentation tools")
for tool, why in (
    ("man", "manual pages"),
    ("whatis", "one-line synopses"),
    ("info", "GNU info manuals"),
    ("tldr", "community examples"),
    ("fzf", "helpme TUI fuzzy finder"),
    ("bat", "syntax-highlighted pager"),
    ("sqlite3", "helpme index"),
):
    path = shutil.which(tool)
    if path:
        row(tool, f"\033[32m{path}\033[0m  \033[90m{why}\033[0m")
    else:
        row(tool, f"\033[33mnot found\033[0m  \033[90m{why}\033[0m")

# --- helpme index coverage --- #
section("helpme index")
row("DB", DB)
if os.path.exists(DB):
    con = sqlite3.connect(DB)
    try:
        con.execute("ALTER TABLE commands ADD COLUMN kind TEXT DEFAULT 'binary'")
        con.commit()
    except sqlite3.OperationalError:
        pass
    total = con.execute("SELECT COUNT(*) FROM commands").fetchone()[0]
    by_kind = con.execute(
        "SELECT COALESCE(kind,'binary'), COUNT(*) FROM commands GROUP BY 1 ORDER BY 2 DESC"
    ).fetchall()
    with_man = con.execute(
        "SELECT COUNT(*) FROM commands WHERE man_text IS NOT NULL AND man_text != ''"
    ).fetchone()[0]
    with_help = con.execute(
        "SELECT COUNT(*) FROM commands WHERE help_short IS NOT NULL AND help_short != ''"
    ).fetchone()[0]
    with_tldr = con.execute(
        "SELECT COUNT(*) FROM commands WHERE tldr_text IS NOT NULL AND tldr_text != ''"
    ).fetchone()[0]
    with_ai = con.execute(
        "SELECT COUNT(*) FROM commands WHERE ai_summary IS NOT NULL AND ai_summary != ''"
    ).fetchone()[0]
    undoc = con.execute(
        """
        SELECT COUNT(*) FROM commands
        WHERE IFNULL(man_text,'')='' AND IFNULL(help_short,'')=''
          AND IFNULL(tldr_text,'')='' AND IFNULL(info_text,'')=''
          AND IFNULL(synopsis,'')=''
        """
    ).fetchone()[0]
    con.close()
    row("Commands", str(total))
    for kind, n in by_kind:
        row(f"  kind:{kind}", str(n))
    row("With man", f"{with_man}  ({100*with_man//max(total,1)}%)")
    row("With --help", f"{with_help}")
    row("With tldr", f"{with_tldr}")
    row("With AI", f"{with_ai}")
    row("No docs at all", f"\033[33m{undoc}\033[0m  → helpme undoc")
else:
    row("Status", "\033[31mmissing — run: helpme reindex\033[0m")

lines.append("")
lines.append(f"\033[90mNext: helpme search <idea> · helpme topics · helpme doctor · helpme undoc\033[0m")
__oval_result__ = "\n".join(lines)
)_python
