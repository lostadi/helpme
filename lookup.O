#!/usr/bin/env O
# helpme lookup — print formatted entry for a single command.
# Surfaces man / --help / tldr / info / AI that would otherwise stay hidden.
#
# Env:
#   HELPME_DB    — path to index.db
#   HELPME_QUERY — command name to look up

python^(
import os, sqlite3, sys, textwrap

DB    = os.environ.get("HELPME_DB",    os.path.expanduser("~/.local/share/helpme/db/index.db"))
name  = os.environ.get("HELPME_QUERY", "").strip()
SEP   = "─" * 72
output = ""

def fmt_entry(row):
    # tolerate older DBs without kind
    if len(row) >= 10:
        cmd_name, path, synopsis, man_text, help_short, ai_summary, indexed_at, tldr_text, info_text, kind = row
    else:
        cmd_name, path, synopsis, man_text, help_short, ai_summary, indexed_at, tldr_text, info_text = row
        kind = "binary"
    kind = kind or "binary"
    kind_col = {"builtin": "35", "topic": "36", "binary": "34"}.get(kind, "34")
    lines = []
    lines.append(
        f"\033[1;32m{cmd_name}\033[0m  "
        f"\033[{kind_col}m[{kind}]\033[0m  "
        f"\033[90m{path}\033[0m"
    )
    lines.append(SEP)

    if ai_summary:
        lines.append(f"\033[1;34m✦ AI Summary\033[0m")
        for l in textwrap.wrap(ai_summary, 72):
            lines.append(f"  {l}")
        lines.append("")

    if synopsis:
        lines.append(f"\033[1;33mSynopsis\033[0m")
        lines.append(f"  {synopsis}")
        lines.append("")

    if tldr_text:
        lines.append(f"\033[1;35mExamples (tldr)\033[0m")
        lines.append(SEP)
        lines.append(tldr_text.rstrip())
        lines.append("")

    if man_text:
        lines.append(f"\033[1;33mMan page\033[0m  \033[90m(indexed {indexed_at[:10] if indexed_at else '?'})\033[0m")
        lines.append(SEP)
        lines.append(man_text.rstrip())
    elif info_text:
        lines.append(f"\033[1;33mInfo page\033[0m  \033[90m(indexed {indexed_at[:10] if indexed_at else '?'})\033[0m")
        lines.append(SEP)
        lines.append(info_text.rstrip())
    elif help_short:
        label = "Shell help" if kind == "builtin" else "--help output"
        lines.append(f"\033[1;33m{label}\033[0m  \033[90m(indexed {indexed_at[:10] if indexed_at else '?'})\033[0m")
        lines.append(SEP)
        lines.append(help_short.rstrip())
    else:
        if not tldr_text:
            lines.append(f"\033[90mNo documentation found.\033[0m")
            lines.append(f"\033[90mThis is an undoc entry — try: helpme ai {cmd_name}\033[0m")

    lines.append("")
    lines.append(f"\033[90mhelpme ai {cmd_name}     — generate AI summary\033[0m")
    lines.append(f"\033[90mhelpme search {cmd_name} — find related by text\033[0m")
    return "\n".join(lines)

if not name:
    output = "[helpme] No command specified. Usage: helpme <command>"
elif not os.path.exists(DB):
    output = "[helpme] Index not found. Run: helpme reindex"
else:
    con = sqlite3.connect(DB)
    # Detect whether kind column exists
    cols = [r[1] for r in con.execute("PRAGMA table_info(commands)")]
    if "kind" in cols:
        sel = ("SELECT name,path,synopsis,man_text,help_short,ai_summary,"
               "indexed_at,tldr_text,info_text,kind FROM commands WHERE name=?")
    else:
        sel = ("SELECT name,path,synopsis,man_text,help_short,ai_summary,"
               "indexed_at,tldr_text,info_text FROM commands WHERE name=?")
    row = con.execute(sel, (name,)).fetchone()

    if row:
        output = fmt_entry(row)
    else:
        like = f"%{name}%"
        matches = [r[0] for r in con.execute(
            "SELECT name FROM commands WHERE name LIKE ? ORDER BY "
            "CASE WHEN name LIKE ? THEN 0 ELSE 1 END, length(name), name LIMIT 8",
            (like, f"{name}%"),
        )]
        # also try FTS if available
        fts_hits = []
        try:
            fts_hits = [r[0] for r in con.execute(
                """
                SELECT c.name FROM commands_fts
                JOIN commands c ON c.rowid = commands_fts.rowid
                WHERE commands_fts MATCH ?
                LIMIT 5
                """,
                ('"' + name.replace('"', '') + '"',),
            )]
        except sqlite3.Error:
            pass
        lines = [f"[helpme] '{name}' not in index."]
        if matches:
            lines.append(f"  Similar names: {', '.join(matches)}")
        if fts_hits:
            lines.append(f"  Text matches:  {', '.join(fts_hits)}")
        lines.append("  Run: helpme reindex   or   helpme search " + name)
        lines.append("  Concepts: helpme topics")
        output = "\n".join(lines)
    con.close()

__oval_result__ = output
)_python
