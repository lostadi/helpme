#!/usr/bin/env O
# helpme search — full-text search across indexed docs.
# Makes commands findable by *what they do*, not only by name.
#
# Env:
#   HELPME_DB    — path to index.db
#   HELPME_QUERY — search string
#   HELPME_LIMIT — max hits (default 25)

python^(
import os, sqlite3, re, sys

DB    = os.environ.get("HELPME_DB", os.path.expanduser("~/.local/share/helpme/db/index.db"))
query = os.environ.get("HELPME_QUERY", "").strip()
limit = int(os.environ.get("HELPME_LIMIT", "25"))
SEP   = "─" * 72
output = ""

def highlight(text, terms, width=72):
    if not text:
        return ""
    low = text.lower()
    pos = -1
    for t in terms:
        i = low.find(t.lower())
        if i >= 0 and (pos < 0 or i < pos):
            pos = i
    if pos < 0:
        snippet = text[:width].replace("\n", " ")
    else:
        start = max(0, pos - 20)
        snippet = text[start:start + width].replace("\n", " ")
        if start > 0:
            snippet = "…" + snippet
        if start + width < len(text):
            snippet = snippet + "…"
    return snippet

if not query:
    output = "[helpme search] Usage: helpme search <words describing what you need>\n" \
             "  Example: helpme search compress archive\n" \
             "           helpme search network ports"
elif not os.path.exists(DB):
    output = "[helpme] Index not found. Run: helpme reindex"
else:
    con = sqlite3.connect(DB)
    try:
        con.execute("ALTER TABLE commands ADD COLUMN kind TEXT DEFAULT 'binary'")
        con.commit()
    except sqlite3.OperationalError:
        pass
    terms = [t for t in re.split(r"\s+", query) if t]
    rows = []
    used_fts = False

    # Prefer FTS5 when available
    try:
        # Quote each token for FTS; OR terms so multi-word is forgiving
        fts_q = " OR ".join('"' + t.replace('"', '""') + '"' for t in terms)
        rows = con.execute(
            """
            SELECT c.name, c.path, c.synopsis, COALESCE(c.kind,'binary'),
                   snippet(commands_fts, 2, '\033[1;33m', '\033[0m', '…', 12) AS snip
            FROM commands_fts
            JOIN commands c ON c.rowid = commands_fts.rowid
            WHERE commands_fts MATCH ?
            ORDER BY rank
            LIMIT ?
            """,
            (fts_q, limit),
        ).fetchall()
        used_fts = True
    except sqlite3.Error:
        rows = []

    if not rows:
        # Fallback: LIKE across visible + hidden text fields
        like_clauses = []
        params = []
        for t in terms:
            like = f"%{t}%"
            like_clauses.append(
                "(name LIKE ? OR synopsis LIKE ? OR man_text LIKE ? "
                "OR help_short LIKE ? OR tldr_text LIKE ? OR IFNULL(ai_summary,'') LIKE ?)"
            )
            params.extend([like] * 6)
        where = " AND ".join(like_clauses) if like_clauses else "1=0"
        params.append(limit)
        rows = con.execute(
            f"""
            SELECT name, path, synopsis, COALESCE(kind,'binary'),
                   COALESCE(synopsis, substr(COALESCE(help_short, man_text, ''), 1, 80))
            FROM commands
            WHERE {where}
            ORDER BY
              CASE WHEN name LIKE ? THEN 0 ELSE 1 END,
              name
            LIMIT ?
            """,
            params[:-1] + [f"%{terms[0]}%" if terms else "%", limit],
        ).fetchall()
        used_fts = False

    if not rows:
        output = (
            f"[helpme search] No matches for: {query}\n"
            f"  Tips: try fewer words, a verb (\"compress\"), or reindex.\n"
            f"  helpme reindex"
        )
    else:
        lines = [
            f"\033[1;32mhelpme search\033[0m  \033[90m{len(rows)} hit(s) for\033[0m  \033[1m{query}\033[0m"
            + (f"  \033[90m(fts)\033[0m" if used_fts else f"  \033[90m(like)\033[0m"),
            SEP,
        ]
        for name, path, synopsis, kind, snip in rows:
            kind = kind or "binary"
            kind_col = {"builtin": "35", "topic": "36", "binary": "34"}.get(kind, "34")
            lines.append(
                f"  \033[1;32m{name:<20}\033[0m "
                f"\033[{kind_col}m{kind:<8}\033[0m "
                f"\033[90m{(synopsis or '')[:48]}\033[0m"
            )
            if snip and snip != (synopsis or ""):
                lines.append(f"      {snip}")
        lines.append("")
        lines.append(f"\033[90mOpen one:  helpme <name>    AI: helpme ai <name>\033[0m")
        output = "\n".join(lines)
    con.close()

__oval_result__ = output
)_python
